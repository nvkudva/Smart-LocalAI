{
  "manifest_version": 3,
  "name": "Smart-LocalAI — Chat & Page Agent",
  "short_name": "Smart-LocalAI",
  "version": "1.0.0",
  "description": "Chat in a Gemini-style sidebar and control the current page (style, content, scripts) with LM Studio, Ollama, or any LLM endpoint.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Smart-LocalAI (Ctrl/Cmd+Shift+Y)",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Smart-LocalAI"
    }
  },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
