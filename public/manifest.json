{
  "manifest_version": 3,
  "name": "Smart LocalAI — Chat & Page Agent",
  "short_name": "SmartLocalAI",
  "version": "1.0.0",
  "homepage_url": "https://nvkudva.github.io/Smart-LocalAI/",
  "description": "Chat in a Gemini-style sidebar and restyle the page you are on with Chrome's built-in AI, LM Studio, Ollama, or any LLM endpoint.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Smart LocalAI (Ctrl/Cmd+Shift+Y)",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Smart LocalAI"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
